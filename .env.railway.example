# Railway Environment Variables Template
# Copy this to Railway's environment variables section

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_KEY can also be used by some modules (same value as anon key)
SUPABASE_KEY=your_supabase_anon_key
# Required for admin backup/restore features
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Optional but strongly recommended: app login passwords
USER_PASSWORD=change_me_user_password
ADMIN_PASSWORD=change_me_admin_password

# Optional: retention settings (days)
PRE_RESTORE_RETENTION_DAYS=30
SNAPSHOT_CLEANUP_LOG_RETENTION_DAYS=90
RESTORE_REPORT_LOG_RETENTION_DAYS=180

# Optional: main page render mode (safe / compat)
# safe: text-only minimal components
# compat: compatibility mode with HTML tables
MAIN_RENDER_MODE=safe

# Optional: Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Optional: Streamlit Configuration  
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false
